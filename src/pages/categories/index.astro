---
import { Icon } from "astro-icon/components";
import ArchivePostCard from "@/components/layout/ArchivePostCard.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts, getCategoryList } from "@/utils/content-utils";

const [categories, posts] = await Promise.all([getCategoryList(), getSortedPosts()]);
const groups = categories.map((category) => ({
	...category,
	posts: posts.filter((post) =>
		(post.data.category?.trim() || i18n(I18nKey.uncategorized)) === category.name,
	),
}));
const totalPosts = posts.length;
---

<MainGridLayout title={i18n(I18nKey.categories)} description={i18n(I18nKey.allCategories)}>
	<div class="card-base px-8 py-6 mb-4">
		<div class="text-2xl font-bold text-(--primary) mb-2">
			{i18n(I18nKey.categories)}
		</div>
		<p class="text-30 text-sm">
			{i18n(I18nKey.allCategories)} · {totalPosts} {i18n(I18nKey.postsCount)}
		</p>
	</div>

	<div class="category-groups">
		{groups.map((category) => (
			<section>
				<h2 class="mb-4">
					<a href={category.url} class="category-heading">
						<span class="text-xl font-bold text-(--primary)">{category.name.trim()}</span>
						<span class="category-rule" aria-hidden="true" />
						<span class="text-sm text-50 shrink-0">
							{category.posts.length} {i18n(category.posts.length === 1 ? I18nKey.postCount : I18nKey.postsCount)}
						</span>
						<Icon name="material-symbols:chevron-right-rounded" class="text-xl text-(--primary)" />
					</a>
				</h2>
				<div class="category-posts">
					{category.posts.map((entry) => <ArchivePostCard entry={entry} />)}
				</div>
			</section>
		))}
	</div>

	{categories.length === 0 && (
		<div class="card-base px-8 py-12 text-center">
			<Icon name="material-symbols:folder-off" class="text-5xl text-30 mx-auto mb-4" />
			<p class="text-30">{i18n(I18nKey.noData)}</p>
		</div>
	)}
</MainGridLayout>

<style>
	.category-groups { display: grid; gap: 2.5rem; padding-top: 0.75rem; }
	.category-posts { display: grid; gap: 1rem; }
	@media (min-width: 600px) {
		.category-posts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (min-width: 1024px) {
		.category-posts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}
	.category-heading {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 0.75rem;
		border-radius: 0.75rem;
		transition: background 180ms ease;
	}
	.category-heading:hover { background: var(--btn-plain-bg-hover); }
	.category-heading > span:first-child { overflow-wrap: anywhere; }
	.category-rule { flex: 1; min-width: 1rem; height: 1px; background: var(--charlore-card-border); }
</style>
