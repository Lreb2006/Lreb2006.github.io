---
import { Icon } from "astro-icon/components";
import ArchivePostCard from "@/components/layout/ArchivePostCard.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts, getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";

const [tags, posts] = await Promise.all([getTagList(), getSortedPosts()]);
const groups = tags.map((tag) => ({
	...tag,
	posts: posts.filter((post) => post.data.tags.includes(tag.name)),
}));
---

<MainGridLayout title={i18n(I18nKey.tags)} description={i18n(I18nKey.allTags)}>
	<div class="card-base px-8 py-6 mb-4">
		<div class="text-2xl font-bold text-(--primary) mb-2">
			{i18n(I18nKey.tags)}
		</div>
		<p class="text-30 text-sm">
			{i18n(I18nKey.allTags)} · {tags.length} {i18n(I18nKey.tagsCount)}
		</p>
	</div>

	<div class="tag-groups">
		{groups.map((tag) => (
			<section>
				<h2 class="mb-4">
					<a href={getTagUrl(tag.name)} class="tag-heading">
						<span class="text-xl font-bold text-(--primary)">{tag.name.trim()}</span>
						<span class="tag-rule" aria-hidden="true" />
						<span class="text-sm text-50 shrink-0">
							{tag.posts.length} {i18n(tag.posts.length === 1 ? I18nKey.postCount : I18nKey.postsCount)}
						</span>
						<Icon name="material-symbols:chevron-right-rounded" class="text-xl text-(--primary)" />
					</a>
				</h2>
				<div class="tag-posts">
					{tag.posts.map((entry) => <ArchivePostCard entry={entry} />)}
				</div>
			</section>
		))}
	</div>

	{tags.length === 0 && (
		<div class="card-base px-8 py-12 text-center">
			<Icon name="material-symbols:tag-rounded" class="text-5xl text-30 mx-auto mb-4" />
			<p class="text-30">{i18n(I18nKey.noData)}</p>
		</div>
	)}
</MainGridLayout>

<style>
	.tag-groups { display: grid; gap: 2.5rem; padding-top: 0.75rem; }
	.tag-posts { display: grid; gap: 1rem; }
	@media (min-width: 600px) {
		.tag-posts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (min-width: 1024px) {
		.tag-posts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}
	.tag-heading {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 0.75rem;
		border-radius: 0.75rem;
		transition: background 180ms ease;
	}
	.tag-heading:hover { background: var(--btn-plain-bg-hover); }
	.tag-heading > span:first-child { overflow-wrap: anywhere; }
	.tag-rule { flex: 1; min-width: 1rem; height: 1px; background: var(--charlore-card-border); }
</style>
