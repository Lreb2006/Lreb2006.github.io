---
import { url } from "@/utils/url-utils";
---

<aside class="highlight-box">
	<img class="highlight-icon" src={url("/favicon/jellyfish.svg")} alt="" width="36" height="36" aria-hidden="true" />
	<div class="highlight-content"><slot /></div>
</aside>

<style>
	.highlight-box {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
		margin: 1.5em 0;
		padding: 1.25rem 1.4rem;
		border: 1px solid rgb(126 184 210 / 22%);
		border-radius: 14px;
		background: linear-gradient(115deg, rgb(211 237 250 / 92%), rgb(229 244 248 / 88%));
		box-shadow: 0 3px 12px rgb(55 110 140 / 5%);
		color: inherit;
		font-size: inherit;
		line-height: inherit;
	}
	.highlight-box .highlight-icon {
		flex: 0 0 2.25rem;
		width: 2.25rem;
		height: 2.25rem;
		margin: 0;
		border-radius: 0;
		object-fit: contain;
	}
	.highlight-content {
		flex: 1;
		min-width: 0;
	}
	.highlight-content :global(> :first-child) { margin-top: 0; }
	.highlight-content :global(> :last-child) { margin-bottom: 0; }
	:global(.dark) .highlight-box {
		background: linear-gradient(115deg, rgb(36 69 88 / 92%), rgb(39 65 76 / 88%));
		border-color: rgb(148 202 228 / 22%);
	}
	@media (max-width: 640px) {
		.highlight-box { padding: 1rem; gap: 0.65rem; }
	}
</style>
