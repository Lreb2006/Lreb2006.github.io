---
import "@/styles/markdown.css";
import "@/styles/markdown-extend.styl";

interface Props {
	class: string;
	lang?: string;
	translationId?: string;
}
const className = Astro.props.class;
---
<div data-pagefind-body lang={Astro.props.lang} data-article-translation-id={Astro.props.translationId} class={`prose prose-sm md:prose-lg dark:prose-invert max-w-none! custom-md ${className}`}>
    <slot/>
</div>

<style>
	.custom-md {
		font-size: 0.8125rem;
	}

	@media (min-width: 48rem) {
		.custom-md {
			font-size: 1.0625rem;
		}
	}
</style>
