---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}

const { style } = Astro.props;
const className = Astro.props.class;
---

<section
	class:list={["card-base", "profile-card", className]}
	style={style}
	data-profile-card
	aria-labelledby="profile-card-name"
>
	<a
		aria-label="前往关于页面"
		href={url("/about/")}
		class="profile-avatar-link group"
		data-profile-avatar
	>
		<span class="profile-avatar-overlay" aria-hidden="true">
			<Icon name="fa7-regular:address-card" />
		</span>
		{profileConfig.avatar ? (
			<ImageWrapper
				src={profileConfig.avatar}
				alt=""
				class="profile-avatar-image"
				loading="eager"
				fetchpriority="high"
				widths={[240]}
				sizes="120px"
			/>
		) : (
			<span class="profile-avatar-placeholder">
				<Icon name="material-symbols:water-drop-outline" />
			</span>
		)}
	</a>

	<div class="profile-content">
		<span class="profile-kicker">PROFILE</span>
		<h2 id="profile-card-name" class="profile-name">{profileConfig.name}</h2>
		{profileConfig.bio && <p class="profile-bio">{profileConfig.bio}</p>}

		<nav class="profile-links" data-profile-links aria-label="外部主页">
			{profileConfig.links.map((item) => {
				const isEmail = item.url.startsWith("mailto:");
				const isExternal = /^https?:\/\//.test(item.url);
				const label = item.showName === false ? undefined : item.name;

				if (isEmail) {
					return (
						<a
							class="profile-link"
							href="#"
							aria-label={item.name}
							data-encoded-email={encodeMailto(item.url)}
							onclick={MAILTO_ONCLICK_SCRIPT}
						>
							<Icon name={item.icon} />
							{label && <span>{label}</span>}
						</a>
					);
				}

				return (
					<a
						class="profile-link"
						href={isExternal ? item.url : url(item.url)}
						aria-label={item.name}
						target={isExternal ? "_blank" : undefined}
						rel={isExternal ? "me noopener noreferrer" : "me"}
					>
						<Icon name={item.icon} />
						{label && <span>{label}</span>}
						{isExternal && (
							<Icon
								name="material-symbols:arrow-outward-rounded"
								class="profile-link-arrow"
							/>
						)}
					</a>
				);
			})}
		</nav>
	</div>
</section>

<style>
	.profile-card {
		position: relative;
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.25rem, 4vw, 2.5rem);
		width: 100%;
		min-height: 11rem;
		padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 4vw, 2.5rem);
		overflow: hidden;
	}

	.profile-card::after {
		position: absolute;
		right: -3.5rem;
		bottom: -4.5rem;
		width: 12rem;
		height: 12rem;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--primary) 13%, transparent);
		content: "";
		filter: blur(1px);
		pointer-events: none;
	}

	.profile-avatar-link {
		position: relative;
		z-index: 1;
		display: block;
		width: 7.5rem;
		height: 7.5rem;
		border: 3px solid color-mix(in srgb, var(--primary) 34%, white 66%);
		border-radius: 9999px;
		box-shadow:
			0 12px 30px color-mix(in srgb, var(--primary) 18%, transparent),
			inset 0 0 0 1px rgb(255 255 255 / 55%);
		overflow: hidden;
		transition:
			transform 180ms ease,
			box-shadow 180ms ease;
	}

	.profile-avatar-link:hover {
		transform: translateY(-2px) rotate(-1deg);
		box-shadow:
			0 16px 34px color-mix(in srgb, var(--primary) 24%, transparent),
			inset 0 0 0 1px rgb(255 255 255 / 65%);
	}

	.profile-avatar-link:focus-visible,
	.profile-link:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--primary) 55%, white 45%);
		outline-offset: 3px;
	}

	.profile-avatar-image,
	.profile-avatar-placeholder {
		display: flex;
		width: 100%;
		height: 100%;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--btn-regular-bg) 86%, white 14%);
	}

	.profile-avatar-placeholder :global(svg) {
		width: 3.5rem;
		height: 3.5rem;
		color: var(--primary);
	}

	.profile-avatar-overlay {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background: rgb(39 69 80 / 45%);
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.profile-avatar-overlay :global(svg) {
		width: 2rem;
		height: 2rem;
		color: white !important;
	}

	.profile-avatar-link:hover .profile-avatar-overlay,
	.profile-avatar-link:focus-visible .profile-avatar-overlay {
		opacity: 1;
	}

	.profile-content {
		position: relative;
		z-index: 1;
		min-width: 0;
	}

	.profile-kicker {
		display: inline-flex;
		margin-bottom: 0.35rem;
		color: color-mix(in srgb, currentColor 68%, transparent);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.18em;
	}

	.profile-name {
		margin: 0;
		font-size: clamp(1.55rem, 4vw, 2rem);
		font-weight: 700;
		line-height: 1.15;
	}

	.profile-bio {
		margin: 0.45rem 0 1.15rem;
		color: color-mix(in srgb, currentColor 68%, transparent);
		font-size: 0.98rem;
	}

	.profile-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.profile-link {
		display: inline-flex;
		height: 2.55rem;
		align-items: center;
		gap: 0.55rem;
		padding: 0 0.9rem;
		border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
		border-radius: 9999px;
		background: color-mix(in srgb, var(--btn-regular-bg) 88%, transparent);
		font-size: 0.88rem;
		font-weight: 700;
		transition:
			transform 160ms ease,
			background-color 160ms ease,
			border-color 160ms ease;
	}

	.profile-link:hover {
		border-color: color-mix(in srgb, var(--primary) 42%, transparent);
		background: var(--btn-regular-bg-hover);
		transform: translateY(-2px);
	}

	.profile-link :global(svg) {
		width: 1.15rem;
		height: 1.15rem;
	}

	.profile-link-arrow {
		width: 0.85rem !important;
		height: 0.85rem !important;
		opacity: 0.5;
	}

	@media (max-width: 640px) {
		.profile-card {
			grid-template-columns: 1fr;
			justify-items: center;
			gap: 1rem;
			padding: 1.5rem 1.15rem;
			text-align: center;
		}

		.profile-avatar-link {
			width: 6.5rem;
			height: 6.5rem;
		}

		.profile-links {
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.profile-avatar-link,
		.profile-avatar-overlay,
		.profile-link {
			transition: none;
		}
	}
</style>
