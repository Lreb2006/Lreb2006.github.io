---
import { type ArticleTranslation, machineTranslationLabels } from "@/i18n/article-translation";
import { siteConfig } from "@/config/siteConfig";
import { activeLocale } from "@/i18n/locale-routes";

interface Props {
	postId: string;
}

const translations = Object.values(import.meta.glob<ArticleTranslation>(
	"/src/data/post-translations/*.json",
	{ eager: true, import: "default" },
)).filter((translation) => translation.postId === Astro.props.postId);
const uiLocale = activeLocale(siteConfig.lang);
const [label, original] = {
	zh_CN: ["译文", "原文"], zh_TW: ["譯文", "原文"], en: ["Translation", "Original"],
	ru: ["Перевод", "Оригинал"], fr: ["Traduction", "Original"], es: ["Traducción", "Original"],
	de: ["Übersetzung", "Original"], ja: ["翻訳", "原文"], ko: ["번역", "원문"],
}[uiLocale];
---

{translations.length > 0 && (
	<article-language-menu hidden data-translations={JSON.stringify(translations)} data-ui-locale={uiLocale} class="mb-4">
		<label class="inline-flex items-center gap-2 text-sm font-medium">
			<span>{label}</span>
			<select class="rounded-lg bg-(--btn-plain-bg-hover) px-2 py-1 text-sm">
				<option value="">{original}</option>
			</select>
		</label>
		<span hidden data-machine-translation-note class="ms-2 text-xs opacity-70">{machineTranslationLabels[uiLocale]}</span>
	</article-language-menu>
)}

<script>
	import { type ArticleTranslation, isArticleText, replaceTextValue, skipArticleElement } from "@/i18n/article-translation";
	import { languageNames } from "@/i18n/locale-routes";
	import { normalizeSiteLang } from "@/utils/site-config-utils";

	class ArticleLanguageMenu extends HTMLElement {
		connectedCallback() {
			const select = this.querySelector("select");
			const machineNote = this.querySelector<HTMLElement>("[data-machine-translation-note]");
			const body = document.querySelector<HTMLElement>("[data-article-translation-id]");
			const title = document.querySelector<HTMLElement>("[data-article-translation-title]");
			if (!select || !body) return;

			const collect = (root: HTMLElement) => {
				const walker = document.createTreeWalker(root, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT, {
					acceptNode(node) {
						if (node instanceof Element) {
							const skip = node.getAttribute("translate") === "no" ||
								skipArticleElement(node.localName, node.classList);
							return skip ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_SKIP;
						}
						return isArticleText(node.textContent ?? "") ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP;
					},
				});
				const nodes: Text[] = [];
				while (walker.nextNode()) nodes.push(walker.currentNode as Text);
				return nodes;
			};
			const nodes = title ? [...collect(title), ...collect(body)] : collect(body);
			const originals = nodes.map((node) => node.data);
			const originalLang = body.lang;
			const originalLocale = normalizeSiteLang(originalLang);
			const translations: ArticleTranslation[] = JSON.parse(this.dataset.translations ?? "[]");
			const available = translations.filter(({ locale, originalLocale: savedLocale, source, translated }) =>
				locale !== originalLocale && (!savedLocale || savedLocale === originalLocale) &&
				source.length === nodes.length && translated.length === nodes.length &&
				source.every((text, index) => text === originals[index].trim()),
			);
			if (!available.length) return;

			for (const { locale } of available) {
				const option = new Option(languageNames[locale], locale);
				option.lang = locale.replace("_", "-");
				select.append(option);
			}
			const applySelection = () => {
				const translation = available.find(({ locale }) => locale === select.value);
				for (const [index, node] of nodes.entries()) {
					node.data = translation
						? replaceTextValue(originals[index], translation.translated[index])
						: originals[index];
				}
				body.lang = translation?.locale.replace("_", "-") ?? originalLang;
				if (title) title.lang = body.lang;
				if (machineNote) machineNote.hidden = !translation?.machine;
			};
			select.onchange = applySelection;
			if (available.some(({ locale }) => locale === this.dataset.uiLocale)) {
				select.value = this.dataset.uiLocale ?? "";
			}
			applySelection();
			this.hidden = false;
		}
	}
	if (!customElements.get("article-language-menu")) {
		customElements.define("article-language-menu", ArticleLanguageMenu);
	}
</script>
