---
import type { MarkdownHeading } from "astro";
import HomeMusicPlayer from "@/components/features/HomeMusicPlayer.astro";
import { musicPlayerConfig } from "@/config";
import BackToComment from "./BackToComment.astro";
import BackToHome from "./BackToHome.astro";
import BackToTop from "./BackToTop.astro";
import FloatingTOC from "./FloatingTOC.astro";

interface Props {
	headings?: MarkdownHeading[];
	encrypted?: boolean;
}

const { headings, encrypted } = Astro.props;
---

<div class="floating-controls-container">
  <FloatingTOC headings={headings ?? []} encrypted={encrypted} />
  <BackToComment />
  <BackToHome />
  <BackToTop />
  {musicPlayerConfig.showFloatingPlayer && <HomeMusicPlayer />}
</div>

<style>
  .floating-controls-container {
    --floating-control-size: 3rem;
    position: fixed;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-end; /* 右对齐 */
    pointer-events: none; /* 容器不阻挡点击 */
    
    /* 默认桌面端位置 - 对应 BackToTop 的位置 */
    right: max(0.75rem, env(safe-area-inset-right));
    bottom: max(0.75rem, env(safe-area-inset-bottom));
  }

  .floating-controls-container :global(.floating-btn),
  .floating-controls-container :global(.home-music-trigger) {
    width: var(--floating-control-size);
    height: var(--floating-control-size);
  }

  .floating-controls-container :global(.floating-btn.hide) {
    display: none;
  }

  @media (max-width: 768px) {
    .floating-controls-container { --floating-control-size: 2.75rem; }
  }

</style>
