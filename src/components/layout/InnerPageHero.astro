---
import ImageWrapper from "@/components/common/ImageWrapper.astro";
---

<!-- 常驻共享布局，由 body.is-home 控制显隐，兼容 Swup 往返导航。 -->
<div class="inner-page-hero" aria-hidden="true">
	<div class="inner-page-hero-light">
		<ImageWrapper
			class="inner-page-hero-desktop"
			src="assets/images/charlore/home-aquarium.webp"
			alt=""
			width={1920}
			widths={[828, 1280, 1920]}
			sizes="100vw"
			layout="full-width"
			loading="lazy"
			quality={82}
			showOverlay={false}
		/>
		<ImageWrapper
			class="inner-page-hero-mobile"
			src="assets/images/charlore/mobile-home-light.webp"
			alt=""
			width={828}
			widths={[320, 480, 640, 828]}
			sizes="100vw"
			layout="full-width"
			loading="lazy"
			quality={80}
			showOverlay={false}
		/>
	</div>
	<div class="inner-page-hero-dark">
		<ImageWrapper
			class="inner-page-hero-desktop"
			src="assets/images/charlore/home-starlight-dark-wide.png"
			alt=""
			width={1448}
			widths={[828, 1280, 1448]}
			sizes="100vw"
			layout="full-width"
			loading="lazy"
			quality={82}
			showOverlay={false}
		/>
		<ImageWrapper
			class="inner-page-hero-mobile"
			src="assets/images/charlore/mobile-home-dark.webp"
			alt=""
			width={828}
			widths={[320, 480, 640, 828]}
			sizes="100vw"
			layout="full-width"
			loading="lazy"
			quality={80}
			showOverlay={false}
		/>
	</div>
</div>

<style>
	:global(:root) {
		--inner-hero-height: clamp(30rem, 92svh, 64rem);
	}

	.inner-page-hero {
		display: none;
		position: absolute;
		z-index: 11;
		top: 0;
		left: 0;
		width: 100%;
		height: var(--inner-hero-height);
		overflow: hidden;
		pointer-events: none;
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 42%, rgb(0 0 0 / 0.86) 58%, rgb(0 0 0 / 0.4) 78%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 0%, #000 42%, rgb(0 0 0 / 0.86) 58%, rgb(0 0 0 / 0.4) 78%, transparent 100%);
	}

	:global(html[data-wallpaper-mode="fullscreen"] body:not(.is-home)) .inner-page-hero {
		display: block;
	}

	.inner-page-hero > div,
	.inner-page-hero :global(picture),
	.inner-page-hero :global(img) { width: 100%; height: 100%; }
	.inner-page-hero-light { display: block; }
	:global(.inner-page-hero-mobile) { display: none; }
	.inner-page-hero :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 42%;
	}

	.inner-page-hero-dark { display: none; }
	.inner-page-hero-dark :global(img) { object-position: center top; }
	:global(html.dark) .inner-page-hero-light { display: none; }
	:global(html.dark) .inner-page-hero-dark { display: block; }

	:global(html[data-wallpaper-mode="fullscreen"] body:not(.is-home) .content-panel) {
		--content-top: calc(var(--inner-hero-height) * 0.74);
	}

	@media (max-width: 900px) {
		:global(:root) {
			--inner-hero-height: clamp(25rem, 72svh, 38rem);
		}
		:global(.inner-page-hero-desktop) { display: none; }
		:global(.inner-page-hero-mobile) { display: block; }
		.inner-page-hero :global(img) { object-position: center top; }
	}
</style>
