---
import lightImage from "@/assets/images/charlore/home-aquarium.webp";
import darkImage from "@/assets/images/charlore/home-starlight-dark-wide.png";
import mobileLightImage from "@/assets/images/charlore/mobile-home-light.webp";
import mobileDarkImage from "@/assets/images/charlore/mobile-home-dark.webp";
---

<!-- 常驻共享布局，由 body.is-home 控制显隐，兼容 Swup 往返导航。 -->
<div class="inner-page-hero" aria-hidden="true">
	<picture class="inner-page-hero-light">
	<source media="(max-width: 900px)" srcset={mobileLightImage.src} />
	<img
		src={lightImage.src}
		width={lightImage.width}
		height={lightImage.height}
		alt=""
		decoding="async"
	/>
	</picture>
	<picture class="inner-page-hero-dark">
	<source media="(max-width: 900px)" srcset={mobileDarkImage.src} />
	<img
		src={darkImage.src}
		width={darkImage.width}
		height={darkImage.height}
		alt=""
		decoding="async"
	/>
	</picture>
</div>

<style>
	:global(:root) {
		--inner-hero-height: clamp(30rem, 92svh, 64rem);
	}

	.inner-page-hero {
		display: none;
		position: absolute;
		z-index: 11;
		top: 0;
		left: 0;
		width: 100%;
		height: var(--inner-hero-height);
		overflow: hidden;
		pointer-events: none;
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 42%, rgb(0 0 0 / 0.86) 58%, rgb(0 0 0 / 0.4) 78%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 0%, #000 42%, rgb(0 0 0 / 0.86) 58%, rgb(0 0 0 / 0.4) 78%, transparent 100%);
	}

	:global(html[data-wallpaper-mode="fullscreen"] body:not(.is-home)) .inner-page-hero {
		display: block;
	}

	.inner-page-hero picture { width: 100%; height: 100%; }
	.inner-page-hero-light { display: block; }
	.inner-page-hero img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 42%;
	}

	.inner-page-hero-dark { display: none; }
	.inner-page-hero-dark img { object-position: center top; }
	:global(html.dark) .inner-page-hero-light { display: none; }
	:global(html.dark) .inner-page-hero-dark { display: block; }

	:global(html[data-wallpaper-mode="fullscreen"] body:not(.is-home) .content-panel) {
		--content-top: calc(var(--inner-hero-height) * 0.74);
	}

	@media (max-width: 900px) {
		:global(:root) {
			--inner-hero-height: clamp(25rem, 72svh, 38rem);
		}
		.inner-page-hero img { object-position: center top; }
	}
</style>
