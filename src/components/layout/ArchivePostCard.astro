---
import type { CollectionEntry } from "astro:content";
import CoverImage from "@/components/common/CoverImage.astro";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { getFileDirFromPath, getPostUrlBySlug } from "@/utils/url-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

interface Props {
	entry: CollectionEntry<"posts">;
}
const { entry } = Astro.props;
const cover = processCoverImageSync(entry.data.image, entry.id);
const date = formatDateToYYYYMMDD(entry.data.published);
---

<a class="cover-tile" href={getPostUrlBySlug(entry.id)} aria-label={entry.data.title}>
	<CoverImage
		src={cover}
		basePath={getFileDirFromPath(entry.filePath || "")}
		alt={entry.data.title}
		class="tile-image"
		preview
		apiUrls={getApiUrlList(entry.data.image, entry.id)}
	/>
	<div class="tile-details">
		{entry.data.category && <span class="tile-category">{entry.data.category}</span>}
		<h3>{entry.data.title}</h3>
		<time datetime={entry.data.published.toISOString()}>{date}</time>
		{entry.data.tags.length > 0 && <p class="tile-tags">{entry.data.tags.map((tag) => `#${tag}`).join(" · ")}</p>}
	</div>
</a>

<style>
	.cover-tile {
		display: block;
		position: relative;
		isolation: isolate;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: 0.9rem;
		background: var(--card-bg);
	}
	.cover-tile :global(.tile-image) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		min-height: 0;
	}
	.tile-details {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.55rem;
		padding: clamp(1rem, 2vw, 1.5rem);
		background: linear-gradient(180deg, rgb(12 20 29 / 65%), rgb(12 20 29 / 90%));
		color: #fff;
		opacity: 0;
		transition: opacity 220ms ease;
	}
	.cover-tile:hover .tile-details,
	.cover-tile:focus-visible .tile-details { opacity: 1; }
	.cover-tile:focus-visible { outline: 3px solid var(--primary); outline-offset: 4px; }
	.tile-details h3 {
		font-size: clamp(1rem, 1.5vw, 1.2rem);
		font-weight: 700;
		line-height: 1.45;
		overflow-wrap: anywhere;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}
	.tile-category { color: #bce4ef; font-size: 0.8rem; }
	.tile-details time, .tile-tags { font-size: 0.75rem; color: #e0e9ee; }
	.tile-tags { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
	@media (hover: none) {
		.tile-details {
			opacity: 1;
			justify-content: flex-end;
			background: linear-gradient(transparent 15%, rgb(12 20 29 / 88%));
		}
		.tile-tags { display: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.tile-details { transition: none; }
	}
</style>
