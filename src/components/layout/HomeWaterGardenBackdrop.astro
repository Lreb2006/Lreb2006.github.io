---
import mobileDarkImage from "@/assets/images/charlore/mobile-home-dark.webp";
import mobileLightImage from "@/assets/images/charlore/mobile-home-light.webp";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import TypewriterText from "@/components/features/TypewriterText.astro";
import HomeTiltImageCard from "@/components/layout/HomeTiltImageCard.astro";

const mobileQuotes = [
	"Don’t walk in front of me, I may not follow.",
	"Don’t walk behind me, I may not lead.",
	"Walk beside me, just be my friend.",
];
---

<section class="home-water-garden-backdrop" aria-label="Charloré 水花园主页背景">
	<div class="home-hero-card-layer" data-home-desktop-hero>
		<template data-home-desktop-hero-template>
			<HomeTiltImageCard />
		</template>
	</div>

	<div class="mobile-home-art" aria-hidden="true">
		<div class="mobile-home-art-image mobile-home-art-light">
			<ImageWrapper
				class="mobile-home-art-render"
				src="assets/images/charlore/mobile-home-light.webp"
				alt=""
				width={mobileLightImage.width}
				widths={[320, 480, 640, 828]}
				sizes="100vw"
				layout="full-width"
				loading="lazy"
				fetchpriority="high"
				quality={80}
				showOverlay={false}
			/>
		</div>
		<div class="mobile-home-art-image mobile-home-art-dark">
			<ImageWrapper
				class="mobile-home-art-render"
				src="assets/images/charlore/mobile-home-dark.webp"
				alt=""
				width={mobileDarkImage.width}
				widths={[320, 480, 640, 828]}
				sizes="100vw"
				layout="full-width"
				loading="lazy"
				fetchpriority="high"
				quality={80}
				showOverlay={false}
			/>
		</div>
	</div>

	<div class="garden-celestial-field" aria-hidden="true">
		<span class="celestial-bokeh celestial-bokeh-one"></span>
		<span class="celestial-bokeh celestial-bokeh-two"></span>
		<span class="celestial-bokeh celestial-bokeh-three"></span>

		<svg class="celestial-orbit celestial-orbit-near" viewBox="0 0 640 520">
			<ellipse cx="268" cy="278" rx="230" ry="112" transform="rotate(-18 268 278)"></ellipse>
			<ellipse class="orbit-dashed" cx="268" cy="278" rx="178" ry="78" transform="rotate(22 268 278)"></ellipse>
			<circle class="orbit-planet planet-coral" cx="488" cy="205" r="18"></circle>
			<circle class="orbit-planet planet-pearl" cx="104" cy="352" r="7"></circle>
			<path d="M268 114v328M42 278h452"></path>
		</svg>

		<svg class="celestial-orbit celestial-orbit-far" viewBox="0 0 560 560">
			<circle cx="280" cy="280" r="204"></circle>
			<circle class="orbit-dashed" cx="280" cy="280" r="146"></circle>
			<ellipse cx="280" cy="280" rx="242" ry="86" transform="rotate(31 280 280)"></ellipse>
			<circle class="orbit-planet planet-cream" cx="424" cy="153" r="13"></circle>
			<circle class="orbit-planet planet-coral" cx="93" cy="327" r="6"></circle>
		</svg>

		<span class="celestial-star star-a">✦</span>
		<span class="celestial-star star-b">✧</span>
		<span class="celestial-star star-c">✦</span>
		<span class="celestial-star star-d">＋</span>
		<span class="celestial-star star-e">✧</span>
		<span class="celestial-star star-f">·</span>
		<span class="celestial-label celestial-label-a">ORBITAL MEMORY / 01</span>
		<span class="celestial-label celestial-label-b">PERIHELION · 18°</span>
		<span class="celestial-label celestial-label-c">CHARLORÉ CELESTIAL FIELD</span>
		<span class="dark-shooting-star shooting-star-a"></span>
		<span class="dark-shooting-star shooting-star-b"></span>
	</div>

	<div class="dark-starlight-layer" aria-hidden="true">
		<svg class="dark-constellation-map" viewBox="0 0 1600 800" preserveAspectRatio="none">
			<path d="M54 204l72-58 66 28 52-71m-118 43 17 86"></path>
			<path d="M1372 117l72 54 68-39m-68 39 44 74"></path>
			<path class="constellation-dashed" d="M72 619l64-46 58 18 43-61"></path>
			<g>
				<circle cx="54" cy="204" r="3"></circle><circle cx="126" cy="146" r="4"></circle>
				<circle cx="192" cy="174" r="2.5"></circle><circle cx="244" cy="103" r="3.5"></circle>
				<circle cx="143" cy="232" r="2.5"></circle><circle cx="1372" cy="117" r="3"></circle>
				<circle cx="1444" cy="171" r="4"></circle><circle cx="1512" cy="132" r="2.5"></circle>
				<circle cx="1488" cy="245" r="3"></circle><circle cx="72" cy="619" r="2.5"></circle>
				<circle cx="136" cy="573" r="3.5"></circle><circle cx="194" cy="591" r="2.5"></circle>
				<circle cx="237" cy="530" r="3"></circle>
			</g>
		</svg>
		<span class="dark-star dark-star-a">✦</span>
		<span class="dark-star dark-star-b">✧</span>
		<span class="dark-star dark-star-c">⋆</span>
		<span class="dark-star dark-star-d">✦</span>
		<span class="dark-star dark-star-e">·</span>
		<span class="dark-star dark-star-f">✧</span>
		<span class="dark-star dark-star-g">✦</span>
		<span class="dark-star dark-star-h">⋆</span>
		<span class="dark-lantern-glyph lantern-glyph-a"></span>
		<span class="dark-lantern-glyph lantern-glyph-b"></span>
	</div>

	<div class="garden-character">
		<div class="garden-pool" aria-hidden="true">
		<span class="garden-bubble bubble-one"></span>
		<span class="garden-bubble bubble-two"></span>
		<span class="garden-bubble bubble-three"></span>
		<span class="garden-bubble bubble-four"></span>
		<span class="garden-bubble bubble-five"></span>
		<span class="garden-bubble bubble-six"></span>
		<span class="garden-bubble bubble-seven"></span>
		<span class="garden-bubble bubble-eight"></span>
		<span class="garden-bubble bubble-nine"></span>
		<span class="garden-spark spark-one">✦</span>
		<span class="garden-spark spark-two">✦</span>

		<svg
			class="garden-jellyfish"
			viewBox="0 0 560 560"
			role="img"
			aria-label="带六条飘带式触手的珍珠色水母"
		>
			<defs>
				<radialGradient id="charlore-bell" cx="38%" cy="20%" r="84%">
					<stop stop-color="#fff"></stop>
					<stop offset=".28" stop-color="#fffbe1"></stop>
					<stop offset=".57" stop-color="#d9edf0"></stop>
					<stop offset=".79" stop-color="#d5dcf3"></stop>
					<stop offset="1" stop-color="#f3c5d0"></stop>
				</radialGradient>
				<linearGradient id="charlore-tentacle-a" x2="1" y2="1">
					<stop stop-color="#fffbe6"></stop>
					<stop offset=".34" stop-color="#d7eef0"></stop>
					<stop offset=".72" stop-color="#a6d2eb"></stop>
					<stop offset="1" stop-color="#e7c8dc"></stop>
				</linearGradient>
				<linearGradient id="charlore-tentacle-b" x2=".8" y2="1">
					<stop stop-color="#fff"></stop>
					<stop offset=".32" stop-color="#f6dce7"></stop>
					<stop offset=".66" stop-color="#c0dce8"></stop>
					<stop offset="1" stop-color="#86c8c8"></stop>
				</linearGradient>
				<linearGradient id="charlore-tentacle-c" x2="1" y2="1">
					<stop stop-color="#fff8d9"></stop>
					<stop offset=".38" stop-color="#e5e4f4"></stop>
					<stop offset=".7" stop-color="#b5dbea"></stop>
					<stop offset="1" stop-color="#f1bdca"></stop>
				</linearGradient>
				<filter id="charlore-soft" x="-30%" y="-20%" width="160%" height="170%">
					<feGaussianBlur stdDeviation="3.4" result="blurred"></feGaussianBlur>
					<feMerge>
						<feMergeNode in="blurred"></feMergeNode>
						<feMergeNode in="SourceGraphic"></feMergeNode>
					</feMerge>
				</filter>
				<filter id="charlore-organic" x="-20%" y="-20%" width="140%" height="150%">
					<feTurbulence baseFrequency=".009 .021" numOctaves="2" seed="12" result="noise"></feTurbulence>
					<feDisplacementMap in="SourceGraphic" in2="noise" scale="3.5"></feDisplacementMap>
				</filter>
			</defs>

			<!-- 六条触手：外、中、内各一对，姿态互相呼应但不机械镜像。 -->
			<g filter="url(#charlore-soft)" stroke="#fff" stroke-opacity=".82" stroke-width="3.2" stroke-linejoin="round">
				<path d="M142 247C112 273 74 277 45 307c-25 26-29 59-9 68 20 8 35-17 47-36 15-24 43-18 72-51 15-17 19-32 18-43-10 3-21 3-31 2Z" fill="url(#charlore-tentacle-a)"></path>
				<path d="M191 257c-22 36-53 57-67 99-13 41 3 77 25 78 22 1 29-33 21-54-10-30 30-68 42-116-7-5-14-7-21-7Z" fill="url(#charlore-tentacle-b)"></path>
				<path d="M245 264c-9 48-30 86-24 139 5 48 31 78 52 69 19-9 9-42-2-62-15-28 14-91 5-146-10 2-21 2-31 0Z" fill="url(#charlore-tentacle-c)"></path>
				<path d="M306 263c12 47-7 91 10 136 16 43 45 65 63 51 18-15-3-43-20-60-22-23 10-80-18-132-11 3-23 5-35 5Z" fill="url(#charlore-tentacle-c)"></path>
				<path d="M361 254c22 34 15 69 47 98 30 27 65 26 73 7 7-20-26-27-46-39-28-17-18-53-35-76-13 5-26 8-39 10Z" fill="url(#charlore-tentacle-b)"></path>
				<path d="M409 241c30 24 46 50 79 61 31 10 58-5 53-25-5-19-35-12-56-14-28-2-35-22-46-36-9 5-19 10-30 14Z" fill="url(#charlore-tentacle-a)"></path>
			</g>
			<g fill="none" stroke="#5e9cae" stroke-opacity=".3" stroke-width="2.2" stroke-linecap="round">
				<path d="M51 350c29-43 70-35 99-91"></path>
				<path d="M146 410c-14-57 45-95 53-143"></path>
				<path d="M258 449c-30-62 12-126 1-174"></path>
				<path d="M356 429c-34-55-1-111-31-157"></path>
				<path d="M461 345c-50-16-48-65-80-83"></path>
				<path d="M513 284c-53 7-69-28-91-39"></path>
			</g>
			<g filter="url(#charlore-organic)">
				<path d="M112 250C114 129 181 62 280 60c102-2 168 70 169 190-81 43-256 45-337 0Z" fill="url(#charlore-bell)" stroke="rgba(255,255,255,.96)" stroke-width="6"></path>
				<path d="M131 221c17-80 71-135 148-138 69-3 122 36 146 112-72-42-220-44-294 26Z" fill="rgba(255,255,255,.26)"></path>
				<path d="M126 244c77 31 232 30 307 0" fill="none" stroke="#5597aa" stroke-opacity=".42" stroke-width="4.5" stroke-linecap="round"></path>
				<path d="M151 186c10-49 35-81 71-100M405 184c-13-44-38-75-73-98" fill="none" stroke="rgba(255,255,255,.72)" stroke-width="10" stroke-linecap="round"></path>
				<path d="M151 176c21 11 42 7 60-9" fill="none" stroke="#f2b6b6" stroke-opacity=".34" stroke-width="22" stroke-linecap="round"></path>
				<path d="M351 169c19 15 38 16 59 2" fill="none" stroke="#f1c4a4" stroke-opacity=".32" stroke-width="20" stroke-linecap="round"></path>
			</g>
			<g fill="#36505d">
				<circle cx="244" cy="178" r="6"></circle>
				<circle cx="320" cy="178" r="6"></circle>
			</g>
			<path d="M265 201c11 13 24 13 35 0" fill="none" stroke="#36505d" stroke-width="4.5" stroke-linecap="round"></path>
			<g fill="#f2b6b6" opacity=".48">
				<ellipse cx="216" cy="201" rx="16" ry="6"></ellipse>
				<ellipse cx="347" cy="201" rx="16" ry="6"></ellipse>
			</g>
			<g fill="rgba(255,255,255,.91)">
				<ellipse cx="193" cy="118" rx="8" ry="15" transform="rotate(35 193 118)"></ellipse>
				<circle cx="367" cy="112" r="4"></circle>
			</g>
		</svg>
		</div>

		<div class="garden-wordmark">
			<span class="garden-wordmark-kicker">CHARLORÉ / AQUATIC MEMORY</span>
			<h1 class="home-water-garden-name" data-text="Charloré"><span>Charloré</span></h1>
			<div class="mobile-home-quote">
				<TypewriterText
					text={mobileQuotes}
					speed={70}
					deleteSpeed={40}
					pauseTime={2200}
				/>
			</div>
			<div class="garden-wordmark-meta" aria-hidden="true">
				<span>NO. 01</span>
				<i></i>
				<span>LIGHT · WATER · MEMORY</span>
			</div>
		</div>
	</div>

	<div class="garden-editorial-layer" aria-hidden="true">
		<svg class="garden-editorial-orbits" viewBox="0 0 1600 800" preserveAspectRatio="none">
			<path d="M116 208C394 66 680 107 884 238c175 113 256 282 514 238"></path>
			<path d="M1026 112c179 58 322 176 403 345"></path>
			<circle cx="1274" cy="238" r="166"></circle>
			<circle cx="1274" cy="238" r="118"></circle>
			<path d="M1274 48v380M1084 238h380"></path>
			<path d="M182 616h288M326 572v88"></path>
		</svg>
		<span class="editorial-label label-index">AQUATIC STUDY / 01</span>
		<span class="editorial-label label-depth">DEPTH · LIGHT · REFRACTION</span>
		<span class="editorial-label label-frame">CHARLORÉ VISUAL ARCHIVE</span>
		<span class="editorial-cross cross-a">＋</span>
		<span class="editorial-cross cross-b">×</span>
		<span class="editorial-cross cross-c">＋</span>
	</div>
</section>

<script>
	import { calculateCelestialParallax } from "@/utils/inverse-tilt";

	const initCelestialParallax = () => {
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

		document.querySelectorAll<HTMLElement>(".home-water-garden-backdrop").forEach((backdrop) => {
			if (backdrop.dataset.celestialReady === "true" || reduceMotion.matches) return;
			backdrop.dataset.celestialReady = "true";

			let animationFrame = 0;
			let pointerX = 0.5;
			let pointerY = 0.5;

			const render = () => {
				const motion = calculateCelestialParallax(pointerX, pointerY, 14);
				backdrop.style.setProperty("--celestial-near-x", `${motion.nearX}px`);
				backdrop.style.setProperty("--celestial-near-y", `${motion.nearY}px`);
				backdrop.style.setProperty("--celestial-far-x", `${motion.farX}px`);
				backdrop.style.setProperty("--celestial-far-y", `${motion.farY}px`);
				animationFrame = 0;
			};

			const scheduleRender = () => {
				if (animationFrame === 0) animationFrame = window.requestAnimationFrame(render);
			};

			backdrop.addEventListener("pointermove", (event) => {
				const bounds = backdrop.getBoundingClientRect();
				pointerX = (event.clientX - bounds.left) / bounds.width;
				pointerY = (event.clientY - bounds.top) / bounds.height;
				backdrop.style.setProperty("--celestial-focus-x", `${pointerX * 100}%`);
				backdrop.style.setProperty("--celestial-focus-y", `${pointerY * 100}%`);
				scheduleRender();
			});

			backdrop.addEventListener("pointerleave", () => {
				pointerX = 0.5;
				pointerY = 0.5;
				backdrop.style.setProperty("--celestial-focus-x", "50%");
				backdrop.style.setProperty("--celestial-focus-y", "50%");
				scheduleRender();
			});
		});
	};

	initCelestialParallax();
	document.addEventListener("astro:page-load", initCelestialParallax);
	document.addEventListener("swup:contentReplaced", initCelestialParallax);
</script>

<style>
	.home-water-garden-backdrop {
		--garden-ink: #729fb2;
		--garden-blue: #badbe3;
		--garden-deep: #83aab5;
		--garden-aqua: #9bc9c6;
		--garden-pink: #a9d7e7;
		--garden-pink-soft: #d8edf4;
		--celestial-near-x: 0px;
		--celestial-near-y: 0px;
		--celestial-far-x: 0px;
		--celestial-far-y: 0px;
		--celestial-focus-x: 50%;
		--celestial-focus-y: 50%;
		position: absolute;
		inset: 0;
		isolation: isolate;
		overflow: hidden;
		background:
			url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.76' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E"),
			repeating-linear-gradient(112deg, rgba(61, 118, 143, 0.034) 0 1px, transparent 1px 31px),
			radial-gradient(circle at var(--celestial-focus-x) var(--celestial-focus-y), rgba(248, 254, 255, 0.4), transparent 17%),
			radial-gradient(ellipse at 48% -12%, rgba(255, 255, 255, 0.82), transparent 40%),
			radial-gradient(ellipse at 8% 26%, rgba(198, 233, 244, 0.78), transparent 31%),
			radial-gradient(ellipse at 91% 18%, rgba(154, 211, 232, 0.52), transparent 29%),
			linear-gradient(180deg, #edf8fb 0%, #d3ebf3 48%, #83bcd2 100%);
		background-blend-mode: soft-light, normal, screen, screen, normal, normal, normal;
		box-shadow: inset 0 -14rem 180px rgba(38, 103, 130, 0.2);
		filter: blur(var(--fullscreen-blur, 0px));
		transform: none;
		transform-origin: center;
	}

	.home-hero-card-layer {
		display: contents;
	}

	:global(body:not(.is-home)) .home-water-garden-backdrop {
		filter: none;
	}

	/* 窄屏保留背景插画，停用会透过半透明内容卡片的星空装饰。 */
	@media (max-width: 900px) {
		.garden-celestial-field,
		.dark-starlight-layer { display: none !important; }
	}

	:global(body:not(.is-home)) :is(
		.home-hero-card-layer,
		.mobile-home-art,
		.garden-character
	) {
		display: none !important;
	}

	:global(html.dark) .home-water-garden-backdrop {
		--garden-ink: #cbeaf2;
		--garden-deep: #83c6d9;
		background:
			url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.72' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.24'/%3E%3C/svg%3E"),
			repeating-linear-gradient(112deg, rgba(214, 242, 248, 0.026) 0 1px, transparent 1px 31px),
			radial-gradient(circle at var(--celestial-focus-x) var(--celestial-focus-y), rgba(194, 236, 247, 0.13), transparent 17%),
			radial-gradient(ellipse at 48% -12%, rgba(222, 247, 251, 0.15), transparent 40%),
			radial-gradient(ellipse at 8% 26%, rgba(64, 130, 151, 0.24), transparent 31%),
			radial-gradient(ellipse at 91% 18%, rgba(57, 122, 150, 0.2), transparent 29%),
			linear-gradient(180deg, #102630 0%, #163442 48%, #174a5d 100%);
		background-blend-mode: soft-light, normal, screen, screen, normal, normal, normal;
		box-shadow: inset 0 -14rem 190px rgba(2, 14, 22, 0.38);
	}

	.home-water-garden-backdrop::before,
	.home-water-garden-backdrop::after {
		content: "";
		position: absolute;
		z-index: 0;
		width: 36vw;
		aspect-ratio: 1;
		border-radius: 50%;
		filter: blur(88px);
		opacity: 0.3;
		pointer-events: none;
		animation: garden-aurora 15s ease-in-out infinite alternate;
	}

	.mobile-home-art {
		display: none;
	}

	.mobile-home-art-dark {
		display: none;
	}

	.mobile-home-art-image :global(picture),
	.mobile-home-art-image :global(img),
	.mobile-home-art-image :global(.mobile-home-art-render) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.mobile-home-quote {
		display: none;
	}

	.home-water-garden-backdrop::before {
		left: -9vw;
		top: 9%;
		background: rgba(226, 248, 251, 0.74);
	}

	.home-water-garden-backdrop::after {
		right: -8vw;
		top: 42%;
		background: rgba(74, 155, 184, 0.42);
		animation-delay: -6s;
	}

	.garden-celestial-field {
		position: absolute;
		z-index: 1;
		inset: 0;
		overflow: hidden;
		color: rgba(246, 253, 255, 0.7);
		pointer-events: none;
	}

	.garden-celestial-field::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image:
			radial-gradient(circle at 8% 13%, currentColor 0 1px, transparent 1.6px),
			radial-gradient(circle at 92% 34%, currentColor 0 1.2px, transparent 1.8px),
			radial-gradient(circle at 15% 81%, currentColor 0 0.9px, transparent 1.5px),
			radial-gradient(circle at 85% 88%, currentColor 0 1px, transparent 1.6px),
			radial-gradient(circle at 48% 8%, currentColor 0 0.8px, transparent 1.4px);
		opacity: 0.7;
	}

	.celestial-orbit {
		position: absolute;
		width: clamp(25rem, 43vw, 47rem);
		height: auto;
		overflow: visible;
		fill: none;
		stroke: currentColor;
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
		will-change: transform;
	}

	.celestial-orbit-near {
		left: clamp(-17rem, -13vw, -8rem);
		bottom: clamp(-14rem, -17vh, -7rem);
		color: rgba(246, 253, 255, 0.78);
		filter: drop-shadow(0 0 16px rgba(212, 244, 250, 0.22));
		transform: translate3d(var(--celestial-near-x), var(--celestial-near-y), 0) rotate(-4deg);
	}

	.celestial-orbit-far {
		right: clamp(-15rem, -11vw, -7rem);
		top: clamp(-14rem, -16vh, -7rem);
		color: rgba(52, 112, 139, 0.38);
