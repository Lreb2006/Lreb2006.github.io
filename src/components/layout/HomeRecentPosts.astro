---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import PostPage from "@/components/layout/PostPage.astro";
import { siteConfig } from "@/config/siteConfig";
import I18nKey from "@/i18n/i18nKey";
import { activeLocale } from "@/i18n/locale-routes";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
const articlesUrl = url("/articles/");
const count = Math.min(posts.length, 5);
const [countLabel, empty, more] = {
	zh_CN: [`最新 ${count} 篇`, "暂时还没有文章", "查看更多文章"],
	zh_TW: [`最新 ${count} 篇`, "暫時還沒有文章", "查看更多文章"],
	en: [`Latest ${count}`, "No posts yet", "More articles"],
	ru: [`Последние публикации (${count})`, "Публикаций пока нет", "Больше статей"],
	fr: [`Dernières publications (${count})`, "Aucun article pour le moment", "Plus d’articles"],
	es: [`Últimas publicaciones (${count})`, "Todavía no hay entradas", "Más artículos"],
	de: [`Neueste Beiträge (${count})`, "Noch keine Beiträge", "Weitere Artikel"],
	ja: [`最新 ${count} 件`, "まだ記事はありません", "ほかの記事を見る"],
	ko: [`최신 글 ${count}개`, "아직 글이 없습니다", "글 더 보기"],
}[activeLocale(siteConfig.lang)];
---

<section class="home-recent-posts" data-home-recent-posts aria-labelledby="home-recent-title">
	<header class="home-recent-header">
		<div>
			<p class="home-recent-kicker">RECENT STORIES</p>
			<h2 id="home-recent-title">{i18n(I18nKey.recentPosts)}</h2>
		</div>
		<span class="home-recent-count">{countLabel}</span>
	</header>

	{
		posts.length > 0 ? (
			<PostPage entries={posts} />
		) : (
			<div class="home-recent-empty card-base">
				<Icon name="material-symbols:article" aria-hidden="true" />
				<div>
					<strong>{empty}</strong>
				</div>
			</div>
		)
	}

	<a class="home-recent-more btn-card" href={articlesUrl} data-home-recent-more>
		<span>{more}</span>
		<Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
	</a>
</section>

<style>
	.home-recent-posts {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.home-recent-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.35rem 0.4rem 0.15rem;
	}

	.home-recent-kicker {
		margin: 0 0 0.15rem;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.18em;
		color: color-mix(
			in srgb,
			var(--charlore-nav-text, var(--charlore-hero-muted)) 72%,
			transparent
		);
	}

	.home-recent-header h2 {
		margin: 0;
		font-size: clamp(1.45rem, 2.5vw, 2rem);
		font-weight: 800;
		line-height: 1.15;
		color: var(--charlore-nav-text, var(--charlore-hero-text));
	}

	.home-recent-count {
		flex: none;
		padding: 0.36rem 0.72rem;
		border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
		border-radius: 9999px;
		background: color-mix(in srgb, var(--card-bg) 76%, transparent);
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--charlore-nav-text, var(--charlore-hero-muted));
		backdrop-filter: blur(12px);
	}

	.home-recent-empty {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.9rem;
		min-height: 9rem;
		padding: 1.5rem;
		text-align: left;
	}

	.home-recent-empty :global(svg) {
		width: 2.2rem;
		height: 2.2rem;
		color: var(--primary);
	}

	.home-recent-empty strong {
		display: block;
		font-size: 1rem;
		color: var(--charlore-nav-text, var(--charlore-hero-text));
	}

	.home-recent-empty p {
		margin: 0.2rem 0 0;
		font-size: 0.86rem;
		color: color-mix(
			in srgb,
			var(--charlore-nav-text, var(--charlore-hero-muted)) 74%,
			transparent
		);
	}

	.home-recent-more {
		display: inline-flex;
		align-self: center;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-width: 10.5rem;
		padding: 0.72rem 1.15rem;
		border-radius: 9999px;
		font-size: 0.9rem;
		font-weight: 800;
		color: var(--charlore-nav-text, var(--charlore-hero-text));
		transition: transform 180ms ease, color 180ms ease;
	}

	.home-recent-more:hover {
		transform: translateY(-2px);
		color: var(--primary);
	}

	.home-recent-more :global(svg) {
		width: 1.2rem;
		height: 1.2rem;
		transition: transform 180ms ease;
	}

	.home-recent-more:hover :global(svg) {
		transform: translateX(0.18rem);
	}

	@media (max-width: 520px) {
		.home-recent-header {
			align-items: center;
		}

		.home-recent-count {
			font-size: 0.7rem;
		}

		.home-recent-empty {
			justify-content: flex-start;
		}
	}
</style>
