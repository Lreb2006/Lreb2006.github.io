---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import PostPage from "@/components/layout/PostPage.astro";
import { url } from "@/utils/url-utils";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
const articlesUrl = url("/articles/");
---

<section class="home-recent-posts" data-home-recent-posts aria-labelledby="home-recent-title">
	<header class="home-recent-header">
		<div>
			<p class="home-recent-kicker">RECENT STORIES</p>
			<h2 id="home-recent-title">近期文章</h2>
		</div>
		<span class="home-recent-count">最新 {Math.min(posts.length, 5)} 篇</span>
	</header>

	{
		posts.length > 0 ? (
			<PostPage entries={posts} />
		) : (
			<div class="home-recent-empty card-base">
				<Icon name="material-symbols:article" aria-hidden="true" />
				<div>
					<strong>暂时还没有文章</strong>
					<p>新的记录会从这里开始出现。</p>
				</div>
			</div>
		)
	}

	<a class="home-recent-more btn-card" href={articlesUrl} data-home-recent-more>
		<span>查看更多文章</span>
		<Icon name="material-symbols:arrow-forward-rounded" aria-hidden="true" />
	</a>
</section>

<style>
	.home-recent-posts {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.home-recent-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.35rem 0.4rem 0.15rem;
	}

	.home-recent-kicker {
		margin: 0 0 0.15rem;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.18em;
		color: color-mix(
			in srgb,
			var(--charlore-nav-text, var(--charlore-hero-muted)) 72%,
			transparent
		);
	}

	.home-recent-header h2 {
		margin: 0;
		font-size: clamp(1.45rem, 2.5vw, 2rem);
		font-weight: 800;
		line-height: 1.15;
		color: var(--charlore-nav-text, var(--charlore-hero-text));
	}

	.home-recent-count {
		flex: none;
		padding: 0.36rem 0.72rem;
		border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
		border-radius: 9999px;
		background: color-mix(in srgb, var(--card-bg) 76%, transparent);
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--charlore-nav-text, var(--charlore-hero-muted));
		backdrop-filter: blur(12px);
	}

	.home-recent-empty {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.9rem;
		min-height: 9rem;
		padding: 1.5rem;
		text-align: left;
	}

	.home-recent-empty :global(svg) {
		width: 2.2rem;
		height: 2.2rem;
		color: var(--primary);
	}

	.home-recent-empty strong {
		display: block;
		font-size: 1rem;
		color: var(--charlore-nav-text, var(--charlore-hero-text));
	}

	.home-recent-empty p {
		margin: 0.2rem 0 0;
		font-size: 0.86rem;
		color: color-mix(
			in srgb,
			var(--charlore-nav-text, var(--charlore-hero-muted)) 74%,
			transparent
		);
	}

	.home-recent-more {
		display: inline-flex;
		align-self: center;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-width: 10.5rem;
		padding: 0.72rem 1.15rem;
		border-radius: 9999px;
		font-size: 0.9rem;
		font-weight: 800;
		color: var(--charlore-nav-text, var(--charlore-hero-text));
		transition: transform 180ms ease, color 180ms ease;
	}

	.home-recent-more:hover {
		transform: translateY(-2px);
		color: var(--primary);
	}

	.home-recent-more :global(svg) {
		width: 1.2rem;
		height: 1.2rem;
		transition: transform 180ms ease;
	}

	.home-recent-more:hover :global(svg) {
		transform: translateX(0.18rem);
	}

	@media (max-width: 520px) {
		.home-recent-header {
			align-items: center;
		}

		.home-recent-count {
			font-size: 0.7rem;
		}

		.home-recent-empty {
			justify-content: flex-start;
		}
	}
</style>
